# Aara Social Matching Backend Configuration
ENVIRONMENT=development
DEMO_MODE=true
APP_NAME="Aara"

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres.xhhmznptzuovqbfnfnuk:hbqJ6PTWFT8pV8D2@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Auth & Persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# Calling Provider ('demo' for simulated calls; 'livekit' or 'agora' for production WebRTC)
CALLING_PROVIDER=demo
CALLING_API_KEY=demo_call_key
CALLING_API_SECRET=demo_call_secret_change_in_production
CALLING_WEBHOOK_SECRET=demo_webhook_secret

# Feature Flags (All disabled by default for Pilot 1)
FEATURE_PRIVATE_VOICE=false
FEATURE_VIDEO=false
FEATURE_PAID_PASS=false

# Google Play Billing (for Paid Pass experiment)
GOOGLE_PLAY_PACKAGE_NAME=com.aara.social
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Admin Console Security
ADMIN_SECRET_KEY=admin-super-secret-key-change-in-production
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin@12345
